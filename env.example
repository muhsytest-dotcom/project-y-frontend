# Frontend environment variables
# Copy to `.env.local` for local development.

# Backend API base URL.
# Keep host aligned with the URL you use in browser for frontend
# (example: localhost with localhost, 127.0.0.1 with 127.0.0.1).
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Staging example:
# NEXT_PUBLIC_API_BASE=https://api.staging.yourapp.com/api/v1

# Production example:
# NEXT_PUBLIC_API_BASE=https://api.yourapp.com/api/v1
